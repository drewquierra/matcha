<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.matcha.controller.DashboardController"
    alignment="TOP_CENTER"
    spacing="0"
    style="-fx-background-color: #E8F5E9;"
    prefWidth="820"
    prefHeight="660">

    <!-- ══ TOP NAV BAR ══ -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: white;
                 -fx-border-color: #C8E6C9;
                 -fx-border-width: 0 0 1.5 0;
                 -fx-padding: 14 24;">

        <Label text="&#x1F375;" style="-fx-font-size: 22px;"/>

        <VBox spacing="1">
            <Label fx:id="welcomeLabel"
                   text="Welcome!"
                   style="-fx-font-size: 17px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2E7D32;"/>
            <Label fx:id="motivationalLabel"
                   text="Mmm, matcha!"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #66BB6A;
                          -fx-font-style: italic;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Logout"
                onAction="#handleLogout"
                style="-fx-background-color: #FFCDD2;
                       -fx-text-fill: #5D4037;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 7;
                       -fx-border-radius: 7;
                       -fx-padding: 7 18;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- ══ MAIN CONTENT AREA ══ -->
    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- ─── LEFT PANEL: Counter ─── -->
        <VBox alignment="CENTER" spacing="20" prefWidth="310"
              style="-fx-background-color: white;
                     -fx-border-color: #C8E6C9;
                     -fx-border-width: 0 1.5 0 0;
                     -fx-padding: 36 28;">

            <Label text="TODAY'S COUNT"
                   style="-fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #BDBDBD;
                          -fx-letter-spacing: 1.5;"/>

            <!-- ─ Big Pink Counter Button ─ -->
            <Button fx:id="counterButton"
                    text="0&#10;&#x1F375;"
                    onAction="#handleIncrement"
                    style="-fx-background-color: #FFCDD2;
                           -fx-text-fill: #5D4037;
                           -fx-font-size: 26px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 100;
                           -fx-border-radius: 100;
                           -fx-border-color: #EF9A9A;
                           -fx-border-width: 2;
                           -fx-min-width: 170;
                           -fx-min-height: 170;
                           -fx-max-width: 170;
                           -fx-max-height: 170;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(255,205,210,0.7), 16, 0, 0, 4);
                           -fx-alignment: center;"/>

            <Label text="Tap to add a cup!"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #BDBDBD;"/>

            <Separator prefWidth="220"/>

            <!-- Log button -->
            <Button fx:id="logButton"
                    text="Log Today's Drinks  &#x2705;"
                    onAction="#handleLogDrinks"
                    prefWidth="230"
                    style="-fx-background-color: #A5D6A7;
                           -fx-text-fill: #1B5E20;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 9;
                           -fx-border-radius: 9;
                           -fx-padding: 11 0;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(165,214,167,0.5), 8, 0, 0, 2);"/>

            <!-- Reset button -->
            <Button text="Reset Counter"
                    onAction="#handleReset"
                    prefWidth="230"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #C8E6C9;
                           -fx-border-width: 1.5;
                           -fx-text-fill: #9E9E9E;
                           -fx-font-size: 12px;
                           -fx-background-radius: 9;
                           -fx-border-radius: 9;
                           -fx-padding: 9 0;
                           -fx-cursor: hand;"/>

            <!-- Status message -->
            <Label fx:id="statusLabel"
                   text=""
                   wrapText="true"
                   maxWidth="230"
                   alignment="CENTER"
                   style="-fx-font-size: 11.5px;
                          -fx-text-fill: #388E3C;
                          -fx-alignment: center;"/>

        </VBox>

        <!-- ─── RIGHT PANEL: Log History Table ─── -->
        <VBox spacing="14" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #E8F5E9;
                     -fx-padding: 28 24 24 24;">

            <!-- Section header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Matcha Log History"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2E7D32;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="All-time records"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #BDBDBD;"/>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="logsTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;
                              -fx-background-radius: 10;
                              -fx-border-color: #C8E6C9;
                              -fx-border-radius: 10;
                              -fx-border-width: 1.5;
                              -fx-table-cell-border-color: #F1F8E9;">
                <columns>
                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="210"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="countColumn"
                                 text="Cups Logged"
                                 prefWidth="160"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="deleteColumn"
                                 text="Actions"
                                 prefWidth="130"
                                 style="-fx-alignment: CENTER;"
                                 sortable="false"
                                 resizable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Footer note -->
            <Label text="* Logging the same day updates the existing entry"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #BDBDBD;"/>

        </VBox>
    </HBox>

</VBox>
